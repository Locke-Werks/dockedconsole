<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dockedconsole</AssemblyName>
    <RootNamespace>DockedConsole</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\dockedconsole.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Docked Console</Product>
    <Company>Locke Werks</Company>
    <Copyright>Copyright (C) 2026 Locke Werks</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <!-- Self-contained so an install has no ".NET Desktop Runtime" prerequisite. Costs
         about 45 MB compressed and removes the most common "it will not start" report.
         Use `dotnet build` for development; publish is the shippable artifact. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- WFO0003 asks us to drop DPI settings from the manifest in favour of the project
         property alone. Keep both: manifest awareness is applied by the OS before any
         managed code runs, and every AppBar coordinate here is a physical pixel, so a
         late or missed SetHighDpiMode would silently misplace the reserved strip. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="dist\**" />
    <None Remove="dist\**" />
  </ItemGroup>

</Project>
